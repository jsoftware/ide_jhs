NB. graphics - drawing on an html canvas
coinsert'jgl2'
require'~addons/ide/jhs/page/jcanvas.ijs'
form=: 'jcanvas;10 10 700 700'jpage''

NB.spxaction: move focus back to term window

can=: can__form

drawadd=: 3 : 0 NB. add lines to drawverb
mydraw=: 3 : (y,~;}.}:<;.2 LF,~5!:5<'mydraw')
i.0 0
)

mydraw=: 3 : 0
'penwidth color1 color2'=. y
jsxnew'' NB. clear drawing buffer
jscreset''            NB. reset canvas
jscbeginPath''        NB. start path that will be painted
jsclineWidth penwidth
jscstrokeStyle jsxucp color1
jscmoveTo 0 0         NB. upper left 
jsclineTo jsxqwh''     NB. lower right
jscstroke''           NB. draw line
)

drawverb__can=: mydraw_base_
glsel can NB. mydraw locale must have the canvas selected

draw__can 5;'red';'green'

drawadd 0 : 0 NB. add lines to draw more stuff
jscbeginPath''
jsclineWidth penwidth*2
jscstrokeStyle jsxucp color2
jscmoveTo 0,{:jsxqwh''
jsclineTo 0,~{.jsxqwh''
jscstroke''

jscbeginPath''
jsclineWidth penwidth
jscstrokeStyle jsxucp color1
jscfillStyle   jsxucp color2
jscrect 200 200 100 100
jscfill''
jscstroke''
jscfont jsxucp '80px Arial'
jscfillText 20 100, jsxucp 'hello Ü'
)

draw__can 5;'red';'green'

drawadd 0 : 0 NB. add lines to draw a pie
r=. 0 , 0.5*o.1
b=. 100 250
jscbeginPath''
jscmoveTo b
jscarc b,50,(jsxradian r),0
jscfillStyle jsxucp 'green'
jscfill''

jscbeginPath''
jscmoveTo b
jscarc b,50,(jsxradian r+0.5*o.1),0
jscfillStyle jsxucp 'red'
jscfill''

jscbeginPath''
jscmoveTo b
jscarc b,50,(jsxradian r+o.1),0
jscfillStyle jsxucp'yellow'
jscfill''

jscbeginPath''
jscmoveTo b
jscarc b,50,(jsxradian r+1.5*o.1),0
jscfillStyle jsxucp'blue'
jscfill''
)

draw__can 5;'red';'green'

drawverb__can=: 3 : 0 
jsxnew''
jscreset''

jsxviewmat 20 20 200 200;#:(~:/&.#:@, +:)^:(<32) 1

jscfont jsxucp '20px Arial'

h=. 1.4*0".(GLFONT i.'p'){.GLFONT

t=. 'iiiwww hello '
jsxtext 250 20;h;t,LF,t

jscfillText 250 100,jsxucp t
wh=. jsxtextwh t
wh=. ({.wh),h
jscfillText (wh+250 100),jsxucp t

jsxlines (40$200 0)+?40$300
)

draw__can''

NB. draw to selected canvas
formx=: 'jcanvas;200 200 700 700'jpage''

NB.spxaction: move focus back to term window

canx=: can__formx
drawverb__canx=: mydraw_base_
glsel canx NB. mydraw locale must have the canvas selected
draw__canx 5;'red';'green'
